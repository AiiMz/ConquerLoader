<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>ExamplePlugin</RootNamespace>
    <AssemblyName>ExamplePlugin</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultItems>false</EnableDefaultItems>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>7.3</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="ExamplePlugin.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ConquerLoader\ConquerLoader.csproj"><Name>ConquerLoader</Name></ProjectReference>
    <ProjectReference Include="..\CLCore\CLCore.csproj"><Name>CLCore</Name></ProjectReference>
  </ItemGroup>
  <ItemGroup><Compile Include="..\WindowsPlatform.cs" Link="Properties\WindowsPlatform.cs" /></ItemGroup>
</Project>
