<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <RootNamespace>ConquerLoader</RootNamespace>
    <AssemblyName>EternalAbyss</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultItems>false</EnableDefaultItems>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>7.3</LangVersion>
  </PropertyGroup>
  <PropertyGroup><UseWPF>true</UseWPF></PropertyGroup>
  <PropertyGroup>
    <ApplicationIcon>ConquerLoaderLogo.ico</ApplicationIcon>
    <StartupObject>ConquerLoader.Program</StartupObject>
    <PlatformTarget>x86</PlatformTarget>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Core.cs" />
    <Compile Include="Forms\About.cs"><SubType>Form</SubType></Compile>
    <Compile Include="Forms\About.Designer.cs"><DependentUpon>About.cs</DependentUpon></Compile>
    <Compile Include="Forms\Main.cs"><SubType>Form</SubType></Compile>
    <Compile Include="Forms\Main.Designer.cs"><DependentUpon>Main.cs</DependentUpon></Compile>
    <Compile Include="Forms\WPF\MainLite.xaml.cs"><DependentUpon>MainLite.xaml</DependentUpon><SubType>Code</SubType></Compile>
    <Compile Include="Forms\WPF\AboutWindow.xaml.cs"><DependentUpon>AboutWindow.xaml</DependentUpon><SubType>Code</SubType></Compile>
    <Compile Include="Forms\WPF\SettingsWindow.xaml.cs"><DependentUpon>SettingsWindow.xaml</DependentUpon><SubType>Code</SubType></Compile>
    <Compile Include="Forms\WPF\WizardWindow.xaml.cs"><DependentUpon>WizardWindow.xaml</DependentUpon><SubType>Code</SubType></Compile>
    <Compile Include="Forms\WPF\PluginsWindow.xaml.cs"><DependentUpon>PluginsWindow.xaml</DependentUpon><SubType>Code</SubType></Compile>
    <Compile Include="Forms\WPF\ServerDatManagerWindow.xaml.cs"><DependentUpon>ServerDatManagerWindow.xaml</DependentUpon><SubType>Code</SubType></Compile>
    <Compile Include="Forms\WPF\SetupLicenseWindow.xaml.cs"><DependentUpon>SetupLicenseWindow.xaml</DependentUpon><SubType>Code</SubType></Compile>
    <Compile Include="Forms\Plugins.cs"><SubType>Form</SubType></Compile>
    <Compile Include="Forms\Plugins.Designer.cs"><DependentUpon>Plugins.cs</DependentUpon></Compile>
    <Compile Include="Forms\ServerDatManager.cs"><SubType>Form</SubType></Compile>
    <Compile Include="Forms\ServerDatManager.Designer.cs"><DependentUpon>ServerDatManager.cs</DependentUpon></Compile>
    <Compile Include="Forms\SetupLicense.cs"><SubType>Form</SubType></Compile>
    <Compile Include="Forms\SetupLicense.Designer.cs"><DependentUpon>SetupLicense.cs</DependentUpon></Compile>
    <Compile Include="Forms\Wizard.cs"><SubType>Form</SubType></Compile>
    <Compile Include="Forms\Wizard.Designer.cs"><DependentUpon>Wizard.cs</DependentUpon></Compile>
    <Compile Include="Models\ServersDatGenerator.cs" />
    <Compile Include="Program.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="Forms\Settings.cs"><SubType>Form</SubType></Compile>
    <Compile Include="Forms\Settings.Designer.cs"><DependentUpon>Settings.cs</DependentUpon></Compile>
    <Compile Include="Properties\Resources.Designer.cs"><AutoGen>True</AutoGen><DesignTime>True</DesignTime><DependentUpon>Resources.resx</DependentUpon></Compile>
    <EmbeddedResource Include="Forms\About.resx"><DependentUpon>About.cs</DependentUpon></EmbeddedResource>
    <EmbeddedResource Include="Forms\Main.resx"><DependentUpon>Main.cs</DependentUpon></EmbeddedResource>
    <EmbeddedResource Include="Forms\Plugins.resx"><DependentUpon>Plugins.cs</DependentUpon></EmbeddedResource>
    <EmbeddedResource Include="Forms\ServerDatManager.resx"><DependentUpon>ServerDatManager.cs</DependentUpon></EmbeddedResource>
    <EmbeddedResource Include="Forms\SetupLicense.resx"><DependentUpon>SetupLicense.cs</DependentUpon></EmbeddedResource>
    <EmbeddedResource Include="Forms\Wizard.resx"><DependentUpon>Wizard.cs</DependentUpon></EmbeddedResource>
    <EmbeddedResource Include="Forms\Settings.resx"><DependentUpon>Settings.cs</DependentUpon></EmbeddedResource>
    <Page Include="Forms\WPF\MainLite.xaml"><Generator>MSBuild:Compile</Generator><SubType>Designer</SubType></Page>
    <Page Include="Forms\WPF\AboutWindow.xaml"><Generator>MSBuild:Compile</Generator><SubType>Designer</SubType></Page>
    <Page Include="Forms\WPF\SettingsWindow.xaml"><Generator>MSBuild:Compile</Generator><SubType>Designer</SubType></Page>
    <Page Include="Forms\WPF\WizardWindow.xaml"><Generator>MSBuild:Compile</Generator><SubType>Designer</SubType></Page>
    <Page Include="Forms\WPF\PluginsWindow.xaml"><Generator>MSBuild:Compile</Generator><SubType>Designer</SubType></Page>
    <Page Include="Forms\WPF\ServerDatManagerWindow.xaml"><Generator>MSBuild:Compile</Generator><SubType>Designer</SubType></Page>
    <Page Include="Forms\WPF\SetupLicenseWindow.xaml"><Generator>MSBuild:Compile</Generator><SubType>Designer</SubType></Page>
    <Page Include="Forms\WPF\SharedTheme.xaml"><Generator>MSBuild:Compile</Generator><SubType>Designer</SubType></Page>
    <EmbeddedResource Include="Properties\Resources.resx"><Generator>ResXFileCodeGenerator</Generator><SubType>Designer</SubType><LastGenOutput>Resources.Designer.cs</LastGenOutput></EmbeddedResource>
    <None Include="Properties\Settings.settings"><Generator>SettingsSingleFileGenerator</Generator><LastGenOutput>Settings.Designer.cs</LastGenOutput></None>
    <Compile Include="Properties\Settings.Designer.cs"><AutoGen>True</AutoGen><DependentUpon>Settings.settings</DependentUpon><DesignTimeSharedInput>True</DesignTimeSharedInput></Compile>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Models\TextTranslation.cs" />
    <Content Include="ConquerLoaderLogo.ico" />
    <Content Include="Resources\CLHook_Legacy.dll" />
    <Resource Include="Resources\CL_BG.png" />
    <Content Include="Resources\ConquerCipherHook.dll" />
    <None Include="Resources\ConquerLoaderLogo.ico" />
    <None Include="Resources\COServerDat.dll" />
    <None Include="Resources\en.json" />
    <None Include="Resources\es.json" />
    <None Include="Resources\pt.json" />
    <None Include="Resources\VC_redist.x64.exe" />
    <None Include="Resources\VC_redist.x86.exe" />
    <None Include="Resources\es.png" />
    <None Include="Resources\en.png" />
    <None Include="Resources\pt.png" />
    <None Include="Resources\TQAnp.dll" />
    <None Include="Resources\ServersXML_5717.xml" />
    <None Include="Resources\COFlashFixer_DLL.dll" />
    <None Include="Resources\ServersXML.xml" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CLCore\CLCore.csproj"><Name>CLCore</Name></ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MetroModernUI" Version="1.4.0.0" />
    <PackageReference Include="Microsoft.AspNet.WebApi.Client" Version="6.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Newtonsoft.Json.Bson" Version="1.0.3" />
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
  </ItemGroup>
  <ItemGroup><None Include="App.config" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
  <ItemGroup><Compile Include="..\WindowsPlatform.cs" Link="Properties\WindowsPlatform.cs" /></ItemGroup>
  <ItemGroup><Compile Include="RuntimeSmoke.cs" /></ItemGroup>
</Project>
