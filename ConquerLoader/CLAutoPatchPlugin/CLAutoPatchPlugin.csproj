<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>CLAutoPatchPlugin</RootNamespace>
    <AssemblyName>CLAutoPatchPlugin</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultItems>false</EnableDefaultItems>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>7.3</LangVersion>
  </PropertyGroup>
  <PropertyGroup><UseWPF>true</UseWPF></PropertyGroup>
  <ItemGroup>
    <Compile Include="AutoPatchConfigurationWindow.xaml.cs"><DependentUpon>AutoPatchConfigurationWindow.xaml</DependentUpon><SubType>Code</SubType></Compile>
    <Compile Include="AutoPatchManifest.cs" />
    <Compile Include="CLAutoPatchPlugin.cs" />
    <Compile Include="AutoPatchSettings.cs" />
    <Compile Include="AutoPatchSettingsStore.cs" />
    <Compile Include="AutoPatchState.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Page Include="AutoPatchConfigurationWindow.xaml"><Generator>MSBuild:Compile</Generator><SubType>Designer</SubType></Page>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CLCore\CLCore.csproj"><Name>CLCore</Name></ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>
  <ItemGroup><Compile Include="..\WindowsPlatform.cs" Link="Properties\WindowsPlatform.cs" /></ItemGroup>
</Project>
